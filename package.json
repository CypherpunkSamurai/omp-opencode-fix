{
  "name": "omp-opencode-fix",
  "version": "0.3.0",
  "description": "OpenCode Zen free models for omp (oh-my-pi), using native HTTP APIs and the OpenCode free-tier fingerprint",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "omp",
    "oh-my-pi",
    "opencode",
    "zen"
  ],
  "files": [
    "src/**/*.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "check": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test:live": "bun run test/live.ts",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "verify": "npm run check && npm test && npm run check:package",
    "prepublishOnly": "npm run verify"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-catalog": "*",
    "@oh-my-pi/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.11.1",
    "@oh-my-pi/pi-catalog": "18.11.1",
    "@oh-my-pi/pi-coding-agent": "18.11.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CypherpunkSamurai/omp-opencode-fix.git"
  },
  "homepage": "https://github.com/CypherpunkSamurai/omp-opencode-fix#readme",
  "bugs": {
    "url": "https://github.com/CypherpunkSamurai/omp-opencode-fix/issues"
  }
}
